NODE_ENV=development
PORT=5000

# Comma-separated credentialed CORS allowlist. No wildcards.
CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=https://wedplan-client-ten.vercel.app,http://localhost:3000
SERVER_URL=http://localhost:5000

MONGODB_URI=
MONGODB_DB_NAME=wedplan

# Generate with: openssl rand -base64 32
# Must be at least 32 characters and must never be exposed to the browser.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
# Allowed values: lax, strict, or none. "none" requires HTTPS and Secure cookies.
BETTER_AUTH_COOKIE_SAME_SITE=lax

# Server-only Google OAuth credentials. Callbacks derive from BETTER_AUTH_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test mode: sk_test_... / whsec_... / price_... placeholders only.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must stay on the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active recurring monthly Premium Price ID from the Stripe Dashboard.
STRIPE_PRICE_ID=

# Server-only ImgBB upload key. The browser uploads through this backend.
IMGBB_API_KEY=

RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=WedPlan <no-reply@your-domain.com>

# Optional escape hatch for pnpm seed:featured. Leave unset in production.
ALLOW_PRODUCTION_FEATURED_SEED=
